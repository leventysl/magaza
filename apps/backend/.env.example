# Kopyalayın: cp .env.example .env — .env repoya girmez.
# Değerleri yerelde doldurun; canlı ortamda barındırma servisinin gizli değişkenlerine yazın.

# PostgreSQL bağlantısı (yerelde docker compose ile: postgres://medusa:<şifre>@localhost:5432/medusa_magaza)
DATABASE_URL=

# İsteğe bağlı; boşsa olay yolu ve önbellek bellekte çalışır (yalnızca geliştirme için)
REDIS_URL=

# İzin verilen web kökenleri (virgülle). Mobil uygulama CORS'a ihtiyaç duymaz.
# Yerelde: STORE_CORS=http://localhost:8081 · ADMIN_CORS=AUTH_CORS=http://localhost:9000
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=

# İmzalama anahtarları: canlıda en az 32 karakter rastgele (openssl rand -base64 48).
# Canlıda boş, kısa ya da bilinen bir değer sunucunun açılmasını engeller.
JWT_SECRET=
COOKIE_SECRET=
